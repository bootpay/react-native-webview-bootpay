{
  "name": "react-native-webview-bootpay",
  "description": "React Native WebView component for iOS, Android, macOS, and Windows",
  "main": "index.js",
  "main-internal": "src/index.ts",
  "react-native": "src/index.ts",
  "typings": "index.d.ts",
  "author": "Jamon Holmgren <jamon@infinite.red>",
  "contributors": [
    "Thibault Malbranche <malbranche.thibault@gmail.com>"
  ],
  "license": "MIT",
  "version": "13.13.49",
  "homepage": "https://github.com/bootpay/react-native-webview-bootpay#readme",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "macos": "react-native run-macos --scheme WebviewExample --project-path example/macos",
    "start": "react-native start",
    "windows": "install-windows-test-app --project-directory example/windows && react-native run-windows --root example --arch x64",
    "ci": "CI=true && yarn lint",
    "ci:publish": "yarn semantic-release",
    "lint": "yarn tsc --noEmit && yarn eslint ./src --ext .ts,.tsx,.js,.jsx",
    "build": "babel --extensions \".ts,.tsx\" --out-dir lib src",
    "prepare:types": "tsc --noEmit false --emitDeclarationOnly --declaration --rootDir src --outDir lib",
    "prepare": "yarn prepare:types && yarn build",
    "appium": "appium",
    "test:windows": "yarn jest --setupFiles=./jest-setups/jest.setup.js",
    "add:macos": "yarn add react-native-macos@0.73.17"
  },
  "rn-docs": {
    "title": "Webview",
    "type": "Component"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "dependencies": {
    "escape-string-regexp": "^4.0.0",
    "invariant": "2.2.4"
  },
  "devDependencies": {
    "@babel/cli": "^7.26.0",
    "@babel/core": "^7.26.0",
    "@babel/runtime": "^7.26.0",
    "@callstack/react-native-visionos": "0.76.7",
    "@react-native/babel-preset": "0.76.7",
    "@react-native/eslint-config": "0.76.7",
    "@react-native/metro-config": "0.76.7",
    "@react-native/typescript-config": "0.76.7",
    "@rnx-kit/metro-config": "2.2.0",
    "@semantic-release/git": "10.0.1",
    "@types/invariant": "^2.2.37",
    "@types/jest": "^29.5.14",
    "@types/react": "18.3.18",
    "@types/selenium-webdriver": "4.1.28",
    "appium": "2.15.0",
    "eslint": "8.57.1",
    "jest": "^29.7.0",
    "prettier": "3.4.2",
    "react": "18.3.1",
    "react-native": "0.76.7",
    "react-native-macos": "0.76.7",
    "react-native-test-app": "3.11.7",
    "react-native-windows": "0.76.7",
    "selenium-appium": "1.0.2",
    "selenium-webdriver": "4.27.0",
    "semantic-release": "24.2.1",
    "typescript": "5.6.3",
    "winappdriver": "^0.0.7"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bootpay/react-native-webview-bootpay.git"
  },
  "files": [
    "android/src",
    "android/build.gradle",
    "android/gradle.properties",
    "apple",
    "ios",
    "macos",
    "windows",
    "lib",
    "src",
    "index.js",
    "index.d.ts",
    "react-native-webview-bootpay.podspec",
    "react-native.config.js"
  ],
  "codegenConfig": {
    "name": "BPCWebViewSpec",
    "type": "all",
    "jsSrcsDir": "./src",
    "android": {
      "javaPackageName": "kr.co.bootpay.webview"
    }
  },
  "packageManager": "yarn@1.22.19"
}
